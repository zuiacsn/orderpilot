<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.orderpilot</groupId>
        <artifactId>orderpilot</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>orderpilot-boot</artifactId>
    <name>orderpilot-boot</name>
    <dependencies>
        <dependency>
            <groupId>com.orderpilot</groupId>
            <artifactId>orderpilot-system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.orderpilot</groupId>
            <artifactId>orderpilot-channel</artifactId>
        </dependency>
        <dependency>
            <groupId>com.orderpilot</groupId>
            <artifactId>orderpilot-product</artifactId>
        </dependency>
        <dependency>
            <groupId>com.orderpilot</groupId>
            <artifactId>orderpilot-oms</artifactId>
        </dependency>
        <dependency>
            <groupId>com.orderpilot</groupId>
            <artifactId>orderpilot-inventory</artifactId>
        </dependency>
        <dependency>
            <groupId>com.orderpilot</groupId>
            <artifactId>orderpilot-wms</artifactId>
        </dependency>
        <dependency>
            <groupId>com.orderpilot</groupId>
            <artifactId>orderpilot-workorder</artifactId>
        </dependency>
        <dependency>
            <groupId>com.orderpilot</groupId>
            <artifactId>orderpilot-agent</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <finalName>orderpilot</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.orderpilot.OrderPilotApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
