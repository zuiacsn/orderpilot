<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.13</version>
        <relativePath/>
    </parent>
    <groupId>com.orderpilot</groupId>
    <artifactId>orderpilot</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>OrderPilot</name>
    <description>电商订单履约与智能异常处理系统</description>
    <modules>
        <module>orderpilot-system</module>
        <module>orderpilot-channel</module>
        <module>orderpilot-product</module>
        <module>orderpilot-oms</module>
        <module>orderpilot-inventory</module>
        <module>orderpilot-wms</module>
        <module>orderpilot-workorder</module>
        <module>orderpilot-agent</module>
        <module>orderpilot-boot</module>
    </modules>
    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring-ai.version>1.1.8</spring-ai.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.orderpilot</groupId>
                <artifactId>orderpilot-system</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orderpilot</groupId>
                <artifactId>orderpilot-channel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orderpilot</groupId>
                <artifactId>orderpilot-product</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orderpilot</groupId>
                <artifactId>orderpilot-oms</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orderpilot</groupId>
                <artifactId>orderpilot-inventory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orderpilot</groupId>
                <artifactId>orderpilot-wms</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orderpilot</groupId>
                <artifactId>orderpilot-workorder</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orderpilot</groupId>
                <artifactId>orderpilot-agent</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
